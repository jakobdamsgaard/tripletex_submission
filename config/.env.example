# Tripletex API Configuration
TRIPLETEX_API_URL=https://kkpqfuj-amager.tripletex.dev/v2
TRIPLETEX_CONSUMER_TOKEN=your_consumer_token_here
TRIPLETEX_EMPLOYEE_TOKEN=your_employee_token_here

# LLM Configuration
LLM_PROVIDER=openai  # or "anthropic"
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
API_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Feature Flags
USE_FILE_ATTACHMENTS=true
USE_VISION_FOR_IMAGES=true
RETRY_FAILED_REQUESTS=true
MAX_RETRIES=3
